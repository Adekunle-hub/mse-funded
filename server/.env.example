# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

NODE_ENV=development
PORT=5000
# Comma-separated frontend origins allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:3000

# Your locally installed PostgreSQL. Create the database first: CREATE DATABASE msefunded;
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/msefunded?schema=public

# Redis, used from Step 5 (job queues). Install locally (Memurai on Windows) or use a hosted Redis URL.
REDIS_URL=redis://localhost:6379

# Signs login tokens. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Free key from tavily.com, used once a day to discover new scholarship pages. Leave empty to skip discovery.
TAVILY_API_KEY=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

# Anthropic API key for reading crawled pages (Haiku screens, Opus extracts).
ANTHROPIC_API_KEY=

# Shared with client/.env.local so the API can tell the website to refresh its listing cache.
REVALIDATE_SECRET=

# Resend key for emails such as password reset links. Until you verify a domain in Resend, it only sends to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=MseFunded <onboarding@resend.dev>

# Google sign-in. Add API_URL/auth/google/callback (for example http://localhost:4000/auth/google/callback) to the OAuth client's authorized redirect URIs.
API_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
