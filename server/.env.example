# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

NODE_ENV=development
PORT=4000
# Comma-separated frontend origins allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:3000

# Your locally installed PostgreSQL. Create the database first: CREATE DATABASE msefunded;
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/msefunded?schema=public

# Redis, used from Step 5 (job queues). Install locally (Memurai on Windows) or use a hosted Redis URL.
REDIS_URL=redis://localhost:6379
